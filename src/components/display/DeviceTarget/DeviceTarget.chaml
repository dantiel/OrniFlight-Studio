~~~
import { transportLabel } from '../../../firmware/flashUi.coffee'
import { getT, useI18n } from '../../../i18n/index.coffee'
statusFor = (isLive, lastError, runtimeConnected) ->
  t = getT()
  if isLive and not lastError then t('flash.breathing')
  else if lastError then t('flash.noSync')
  else if runtimeConnected then t('flash.connected')
  else t('flash.dryRun')
firmwareFor = (runtimeConnected, ri, fallback) ->
  if runtimeConnected and ri?.firmware?.version
    "app #{ri.firmware.version}"
  else
    fallback or '—'
~~~

- { t } = useI18n()
- c = props.ctrl || {}
- d = props.device || c.device || {}
- transport = props.transport || c.transport || 'sim'
- isLive = transport in ['serial', 'webusb']
- serialSupported = props.serialSupported ? c.serialSupported ? false
- webUsbSupported = props.webUsbSupported ? c.webUsbSupported ? false
- anySupported = serialSupported or webUsbSupported
- lastError = props.lastError || c.lastError || null
- detecting = props.detecting ? c.detecting ? false
- runtimeConnected = props.runtimeConnected ? c.runtimeConnected ? false
- runtimeIdentity = props.runtimeIdentity || c.runtimeIdentity || null
- ri = runtimeIdentity || null
- rc = runtimeConnected
- onBridge = props.onBridge || c.onBridge || (->)
- hasLastError = lastError and not detecting
- status = statusFor isLive, lastError, runtimeConnected
- transportName = transportLabel(transport)
- dName = rc and ri?.name or d.name or 'OrniFlight'
- dTarget = rc and ri?.board?.targetName or d.target or 'ORNI-F4'
- dFirmware = firmwareFor rc, ri, d.firmware
- detectLabel = if detecting then t('flash.scanningDetect') else t('flash.detectBoard')
- bridgeLabel = if detecting then t('flash.scanningDetect') else t('flash.enterBootloaderRow')
- detectDisabled = !!detecting
- onDetectSerial = props.onDetectSerial || c.onDetectSerial || (->)
- onDetectWebUsb = props.onDetectWebUsb || c.onDetectWebUsb || (->)
- releaseOnClick = props.onDisconnect || c.onDisconnect || (->)
- targetClass = "device-target#{if isLive then ' live' else ''}"
- transportClass = "device-transport#{if isLive then ' live' else ''}"
- liveStatus = isLive or runtimeConnected
- statusClass = "device-status#{if liveStatus then ' live' else ''}"
.device-target{ className: targetClass }
  .device-head
    %span.device-glyph
      = '🐦'
    .device-name
      %div.device-title= dName
      %div.device-sub= dTarget
    %span.device-transport{ className: transportClass }
      = transportName
  .device-body
    .device-row
      %span.device-row-label= t('flash.mcu')
      %span.device-row-value= d.mcu || '—'
    .device-row
      %span.device-row-label= t('flash.flashRom')
      %span.device-row-value= d.flash || '—'
    .device-row
      %span.device-row-label= t('flash.firmware')
      %span.device-row-value= dFirmware
    .device-row
      %span.device-row-label= t('flash.bootloaderRow')
      %span.device-row-value= d.bootloader || '—'
    - if hasLastError
      .device-row.device-row-error
        %span.device-row-label= t('flash.sync')
        %span.device-row-value= lastError
  .device-foot
    %span.device-uid= d.uid || ''
    %span.device-status{ className: statusClass }
      = status
  - if anySupported
    .device-actions
      - if isLive
        %button.device-btn{ onClick: releaseOnClick }
          = t('flash.release')
      - else if runtimeConnected
        %button.device-btn{ onClick: onBridge, disabled: detectDisabled }
          = bridgeLabel
      - else
        - if serialSupported
          %button.device-btn{ onClick: onDetectSerial, disabled: detectDisabled }
            = t('flash.serial')
        - if webUsbSupported
          %button.device-btn.usb{ onClick: onDetectWebUsb, disabled: detectDisabled }
            = t('flash.usbDfu')