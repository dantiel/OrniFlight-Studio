- import AnimatedValue from '../../motion/AnimatedValue/AnimatedValue.coffee'
.readout
  - for item, i in (props.items || [])
    .readout-item{ key: i }
      %span.readout-label
        = item.label
      %span.readout-value
        - if typeof item.value == 'number'
          %AnimatedValue{ value: item.value, decimals: item.decimals || 1, suffix: item.suffix || '' }
        - else
          = item.value
