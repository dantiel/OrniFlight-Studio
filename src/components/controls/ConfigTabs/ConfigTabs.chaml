import { NavLink } from 'react-router-dom'

.config-view-selector{ role: 'navigation', aria-label: 'View navigation' }
  %NavLink{ to: '/device', end: true, className: 'config-view-btn', data-glyph: '◫' }
    %span.tab-label Device
  %NavLink{ to: '/airframe', end: true, className: 'config-view-btn', data-glyph: '⌁' }
    %span.tab-label Airframe
  %NavLink{ to: '/control', end: true, className: 'config-view-btn', data-glyph: '△' }
    %span.tab-label Flight Control
  %NavLink{ to: '/receiver', end: true, className: 'config-view-btn', data-glyph: '⇄' }
    %span.tab-label Receiver
  %NavLink{ to: '/power', end: true, className: 'config-view-btn', data-glyph: 'ϟ' }
    %span.tab-label Power
  %NavLink{ to: '/sensors', end: true, className: 'config-view-btn', data-glyph: '◎' }
    %span.tab-label Sensors
  %NavLink{ to: '/safety', end: true, className: 'config-view-btn', data-glyph: '◇' }
    %span.tab-label Safety
  %NavLink{ to: '/data', end: true, className: 'config-view-btn', data-glyph: '▦' }
    %span.tab-label Data
  %NavLink{ to: '/flash', end: true, className: 'config-view-btn', data-glyph: '↯' }
    %span.tab-label Flash Firmware
