~~~
import { NavLink, useLocation } from 'react-router-dom'
import { activeModuleForPath, subtabsForPath } from '../../../lib/navigation.coffee'
import Icon from '../../primitives/Icon/Icon.coffee'
~~~

- location = useLocation()
- mod = activeModuleForPath location.pathname
- subtabs = subtabsForPath location.pathname
.config-view-selector{ role: 'navigation', aria-label: "#{mod.label} navigation" }
  .config-module
    %Icon{ name: mod.icon, size: 13, className: 'cm-icon' }
    %span.config-module-name= mod.label
  - if subtabs.length > 1
    .config-view-tabs
      - for tab in subtabs
        %NavLink{ to: tab[0], key: tab[0], className: 'config-view-btn' }
          %span.tab-label= tab[1]