~~~
import { ARRANGEMENT_CATALOG } from '../../../lib/arrangementCatalog.coffee'
import SidebarSection from '../../layout/SidebarSection/SidebarSection.coffee'
import SidebarItem from '../../primitives/SidebarItem/SidebarItem.chaml'
import ParamRow from '../../primitives/ParamRow/ParamRow.chaml'
import useEngineStore from '../../../stores/useEngineStore.coffee'
import { callWith, floatFromEvent } from '../../../lib/essential.coffee'
import { useI18n } from '../../../i18n/index.coffee'
~~~

- { t } = useI18n()
- sim = useEngineStore()
- sp = sim.simParams
.studio-arrangement
  %SidebarSection{ heading: t('flight.arrangement') }
    - for a in ARRANGEMENT_CATALOG
      %SidebarItem{ key: a.id, label: a.label, active: a.id == sim.arrangement, onClick: callWith(sim.applyArrangement, a.id) }
  %SidebarSection{ heading: t('flight.aeroelastic') }
    %ParamRow{ key: 'yaw-amp-mix', label: t('flight.yawAmpMix'), value: sp.yawAmpMix, min: '0', max: '1', step: '0.05', display: String(sp.yawAmpMix), onInput: floatFromEvent((v) -> sim.setSimulationParams { yawAmpMix: v }) }
    %ParamRow{ key: 'aero-flap', label: t('flight.aeroFlap'), value: sp.aeroelasticFlapCoefficient, min: '0', max: '60', step: '1', display: String(sp.aeroelasticFlapCoefficient), onInput: floatFromEvent((v) -> sim.setSimulationParams { aeroelasticFlapCoefficient: v }) }
    %ParamRow{ key: 'aero-glide', label: t('flight.aeroGlide'), value: sp.aeroelasticGlideCoefficient, min: '0', max: '20', step: '1', display: String(sp.aeroelasticGlideCoefficient), onInput: floatFromEvent((v) -> sim.setSimulationParams { aeroelasticGlideCoefficient: v }) }
    %ParamRow{ key: 'self-level', label: t('flight.selfLevel'), value: sp.selfLevelGain, min: '0', max: '8', step: '0.5', display: String(sp.selfLevelGain), onInput: floatFromEvent((v) -> sim.setSimulationParams { selfLevelGain: v }) }
    %ParamRow{ key: 'servo-travel', label: t('flight.servoTravel'), value: sp.servoTravelTimeMs, min: '30', max: '500', step: '10', display: String(sp.servoTravelTimeMs) + 'ms', onInput: floatFromEvent((v) -> sim.setSimulationParams { servoTravelTimeMs: v }) }
