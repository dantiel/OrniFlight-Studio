~~~
import './BatteryPanel.sass'
import usePowerStore from '../../../stores/usePowerStore.coffee'
import { VOLTAGE_METER_SOURCES, CURRENT_METER_SOURCES } from '../../../lib/powerCatalog.coffee'
import { useI18n } from '../../../i18n/index.coffee'
~~~

- store = usePowerStore()
- { t } = useI18n()
- battery = store.draft.battery
- valueFromEvent = (f) -> (event) -> f Number(event.target.value)
- setMinCell = (value) -> store.setBattery { minCellVoltage: value }
- setMaxCell = (value) -> store.setBattery { maxCellVoltage: value }
- setWarnCell = (value) -> store.setBattery { warningCellVoltage: value }
- setCapacity = (value) -> store.setBattery { capacityMah: value }
- setVoltSource = (value) -> store.setBattery { voltageMeterSource: value }
- setCurrSource = (value) -> store.setBattery { currentMeterSource: value }
- voltSources = VOLTAGE_METER_SOURCES.filter (source) -> source.supported
- currSources = CURRENT_METER_SOURCES.filter (source) -> source.supported
%Section{ heading: t('power.battery'), subheading: t('power.batterySub') }
  .power-grid.panel-battery
    %label.power-field
      %span.power-field-label= t('power.minCell')
      %input.power-input{ type: 'number', min: '0', max: '500', step: '1', value: String(battery.minCellVoltage), onChange: valueFromEvent(setMinCell) }
    %label.power-field
      %span.power-field-label= t('power.maxCell')
      %input.power-input{ type: 'number', min: '0', max: '500', step: '1', value: String(battery.maxCellVoltage), onChange: valueFromEvent(setMaxCell) }
    %label.power-field
      %span.power-field-label= t('power.warnCell')
      %input.power-input{ type: 'number', min: '0', max: '500', step: '1', value: String(battery.warningCellVoltage), onChange: valueFromEvent(setWarnCell) }
    %label.power-field
      %span.power-field-label= t('power.capacity')
      %input.power-input{ type: 'number', min: '0', max: '65535', step: '1', value: String(battery.capacityMah), onChange: valueFromEvent(setCapacity) }
    %label.power-field
      %span.power-field-label= t('power.voltSource')
      %select.power-input{ value: String(battery.voltageMeterSource), onChange: valueFromEvent(setVoltSource) }
        - for source in voltSources
          %option{ key: "volt-src-#{source.id}", value: String(source.id) }
            = source.label
    %label.power-field
      %span.power-field-label= t('power.currSource')
      %select.power-input{ value: String(battery.currentMeterSource), onChange: valueFromEvent(setCurrSource) }
        - for source in currSources
          %option{ key: "curr-src-#{source.id}", value: String(source.id) }
            = source.label
  %p.power-note
    = t('power.batteryNote')
