~~~
import './SensorCalibratePanel.sass'
import { useState } from 'react'
import useSensorsStore from '../../../stores/useSensorsStore.coffee'
import useDeviceStore from '../../../stores/useDeviceStore.coffee'
import { useI18n } from '../../../i18n/index.coffee'
~~~

- store = useSensorsStore()
- { t } = useI18n()
- status = useDeviceStore (state) -> state.status
- [feedback, setFeedback] = useState null
- deviceReady = store.mode == 'device' and store.session?
- armed = Boolean(status?.armed)
- ok = (label) -> -> setFeedback { kind: 'ok', text: t('sensors.accepted', { label: label }) }
- fail = (label) -> (error) -> setFeedback { kind: 'error', text: error?.message or t('sensors.failed', { label: label }) }
- run = (action, label) -> -> setFeedback { kind: 'running', text: t('sensors.running', { label: label }) }; action().then(ok label).catch(fail label)
- calibrateNote = if armed then t('sensors.writesLocked') else t('sensors.calibrationNote')
%Section{ heading: t('sensors.calibration'), subheading: t('sensors.calibrationSub') }
  .sensors-calibrate.panel-sensor-calibrate
    %button.sensors-cal-button{ type: 'button', onClick: run((-> store.calibrateAccel()), t('sensors.calibrateAccel')), disabled: !deviceReady or armed }
      = t('sensors.calibrateAccel')
    %button.sensors-cal-button{ type: 'button', onClick: run((-> store.calibrateMag()), t('sensors.calibrateMag')), disabled: !deviceReady or armed }
      = t('sensors.calibrateMag')
    - if feedback
      %span.sensors-feedback{ className: "sensors-feedback-#{feedback.kind}" }
        = feedback.text
  %p.sensors-note
    = calibrateNote
