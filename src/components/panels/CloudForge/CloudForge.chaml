~~~
import {
  FORGE_FEATURES, hasFeature
} from '../../../firmware/forgeFeatures.coffee'
import { useState } from 'react'
import { useI18n } from '../../../i18n/index.coffee'
~~~

- { t } = useI18n()
- forge = props.forge || {}
- [target, setTarget] = useState 'TINYFISH'
- [versionTag, setVersionTag] = useState ''
- targets = forge.targets || []
- current = forge.current
- online = forge.online
- configured = forge.configured
- done = current?.ready and current?.conclusion == 'success'
- failed = current?.ready and not done
- statusText = current?.status or 'idle'
- statusClass = { true: 'online', false: 'offline' }[online] ? 'unknown'
- statusWord = { true: t('flash.forgeOnline'), false: t('flash.forgeOffline') }[online] ? '…'
- buildLabel = if forge.building then t('flash.forging') else t('flash.forgeBuild')
- loadLabel = if forge.loading then t('flash.loading') else t('flash.loadImage')
- features = forge.features || []
- pickTarget = (e) -> setTarget(e.target.value)
- pickTag = (e) -> setVersionTag(e.target.value)
- build = -> forge.onBuild && forge.onBuild(target, versionTag.trim())
- loadRun = (id) -> forge.onLoad && forge.onLoad(id)
- shortSha = (sha) -> (sha or '').slice(0, 7)
- shortDate = (d) -> (d or '').slice(0, 10)
- runError = forge.error or current?.error or "Build #{current?.conclusion}"
.cloud-forge
  .cf-head
    %div.cf-head-copy
      %span.cf-head-title= t('flash.forge')
      %span.cf-head-sub= t('flash.forgeSub')
    %span.cf-status{ className: "cf-status #{statusClass}" }
      %span.cf-dot
      %span.cf-status-word= statusWord
  - unless configured
    .cf-banner
      %span.cf-banner-glyph ⚒️
      %span.cf-banner-text
        = t('flash.forgeNotConfigured')
  - else
    .cf-body
      .cf-buildline
        %label.cf-field
          %span.cf-label= t('flash.target')
          %select.cf-select{ value: target, onChange: pickTarget }
            - for tgt in targets
              %option{ key: tgt, value: tgt }= tgt
        %label.cf-field.cf-field-grow
          %span.cf-label= t('flash.buildLabel')
          %input.cf-input{ type: 'text', placeholder: t('flash.buildLabelPlaceholder'), value: versionTag, onChange: pickTag }
        %button.cf-build{ disabled: forge.building or forge.loading, onClick: build }
          = buildLabel
      .cf-flags
        .cf-flags-head
          %span.cf-flags-title= t('flash.buildFlags')
          %span.cf-flags-count= t('flash.flagsCount', { n: features.length, total: FORGE_FEATURES.length })
        .cf-flag-grid
          - for f in FORGE_FEATURES
            %label.cf-flag{ key: f.id, className: "cf-flag#{if hasFeature(features, f.id) then ' on' else ' off'}" }
              %input.cf-flag-check{ type: 'checkbox', checked: hasFeature(features, f.id), onChange: (-> forge.onToggleFeature && forge.onToggleFeature(f.id)) }
              %span.cf-flag-box= "#{if hasFeature(features, f.id) then '✓' else '—'}"
              %span.cf-flag-copy
                %span.cf-flag-label= f.label
                %span.cf-flag-blurb= f.blurb
              %code.cf-flag-define= f.define
      - if current
        .cf-run
          .cf-run-line
            %span.cf-run-label= t('flash.status')
            %span.cf-run-value= statusText
          - if current.htmlUrl
            %a.cf-run-link{ href: current.htmlUrl, target: '_blank', rel: 'noopener' }= t('flash.githubRun')
          - if done
            %button.cf-load{ disabled: forge.loading, onClick: (-> loadRun(current.runId)) }
              = loadLabel
          - if failed
            %div.cf-run-error= runError
      - if forge.error and not current
        %div.cf-error= forge.error
      - if forge.history.length
        .cf-history
          %div.cf-history-title= t('flash.recentBuilds')
          - for b in forge.history.slice(0, 6)
            %button.cf-history-item{ key: b.run_id, onClick: (-> loadRun(b.run_id)) }
              %span.cf-history-sha= shortSha(b.head_sha)
              %span.cf-history-date= shortDate(b.created_at)