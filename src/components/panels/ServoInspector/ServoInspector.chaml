---
pidDefs = [
  { id: 'roll_P',  label: 'Roll P' }
  { id: 'roll_I',  label: 'Roll I' }
  { id: 'roll_D',  label: 'Roll D' }
  { id: 'pitch_P', label: 'Pitch P' }
  { id: 'pitch_I', label: 'Pitch I' }
  { id: 'pitch_D', label: 'Pitch D' }
  { id: 'yaw_P',   label: 'Yaw P' }
  { id: 'yaw_I',   label: 'Yaw I' }
  { id: 'yaw_D',   label: 'Yaw D' }
]

ondasDefs = [
  { id: 'cadence_gain',     label: 'Cadence' }
  { id: 'ferocity_p_gain',  label: 'Ferocity P' }
  { id: 'ferocity_d_gain',  label: 'Ferocity D' }
  { id: 'balance_gain',     label: 'Balance' }
  { id: 'warp_gain',        label: 'Warp' }
  { id: 'anchor_gain',      label: 'Anchor' }
  { id: 'resonance_gain',   label: 'Resonance' }
]

servoDefs = [
  { id: 'midpoint', label: 'Midpoint', min: '500', max: '2500', step: '1' }
  { id: 'min', label: 'Min PWM', min: '500', max: '2500', step: '1' }
  { id: 'max', label: 'Max PWM', min: '500', max: '2500', step: '1' }
  { id: 'rate', label: 'Rate', min: '-100', max: '100', step: '1' }
  { id: 'amplitudeScale', label: 'Amplitude', min: '0', max: '2', step: '0.1' }
]

SERVO_FORMATS =
  rate: (v) -> "#{v}%"
  amplitudeScale: (v) -> v.toFixed 1

SERVO_PARSERS = amplitudeScale: parseFloat

servoDisplay = (servo, s) ->
  (SERVO_FORMATS[s.id] ? String)(servo[s.id] ? 0)

servoParse = (s) -> SERVO_PARSERS[s.id] ? parseInt
---
- import { parsedFromEvent, floatFromEvent, intFromEvent } from '../../../lib/essential.coffee'
- mode = props.mode || 'all'
.studio-inspector
  - if mode == 'servos' or mode == 'all'
    %Section{ heading: "Servo #{props.index + 1}: Wing Shape" }
      - for s in servoDefs
        %ParamRow{ key: s.id, label: s.label, value: (props.servo || {})[s.id] || 0, min: s.min, max: s.max, step: s.step, display: servoDisplay(props.servo || {}, s), onInput: parsedFromEvent(props.onParamChange, servoParse(s), props.index, s.id) }
  - if mode == 'pid' or mode == 'all'
    %Section{ heading: 'PID Response', subheading: 'How the bird corrects disturbance.' }
      - for p in pidDefs
        %ParamRow{ key: p.id, label: p.label, value: props.pidGains?[p.id] || 0, min: '0', max: (if p.id.includes('_I') then '0.2' else if p.id.includes('_D') then '50' else '15'), step: (if p.id.includes('_I') then '0.01' else if p.id.includes('_D') then '0.5' else '0.1'), display: String(props.pidGains?[p.id] || 0), onInput: floatFromEvent(props.onPidChange, p.id) }
  - if mode == 'ondas' or mode == 'all'
    %Section{ heading: 'ONDAS Mixer', subheading: 'Phase-aware modulation.' }
      - for o in ondasDefs
        %ParamRow{ key: o.id, label: o.label, value: props.ondasParams?[o.id] || 0, min: '0', max: '100', display: String(props.ondasParams?[o.id] || 0), onInput: intFromEvent(props.onOndasChange, o.id) }