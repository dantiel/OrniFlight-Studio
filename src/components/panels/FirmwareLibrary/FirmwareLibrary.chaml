~~~
import { fmtBytes } from '../../../firmware/firmwareCatalog.coffee'
~~~

- c = props.ctrl || {}
- catalog = props.catalog || c.catalog || []
- localImage = props.localImage ? c.localImage
- cloudImage = props.cloudImage ? c.cloudImage
- selectedId = props.selectedId ? c.selectedId
- loading = !!props.loading or !!c.loading
- onLocal = props.onLoadLocal || c.onLoadLocal || (->)
- onSelect = props.onSelect || c.onSelect || (->)
- total = catalog.length + (if localImage then 1 else 0) + (if cloudImage then 1 else 0)
.firmware-library
  .fw-head
    %span.fw-head-title Firmware Images
    %span.fw-head-count= String(total)
  .fw-local
    %label.fw-local-btn
      %span.fw-local-glyph 🪶
      %span.fw-local-text Load local image
      %input.fw-local-input{ type: 'file', accept: '.bin,.hex,.elf', onChange: (e) -> onLocal(e.target.files?[0]) }
  - if loading
    .fw-empty
      %span.fw-empty-glyph 📡
      .fw-empty-text Scanning the nest for images…
  - else if total == 0
    .fw-empty
      %span.fw-empty-glyph 🪶
      .fw-empty-text No firmware found — load a local image.
  - else
    .fw-list
      - if cloudImage
        %button.fw-card{ className: "fw-card#{if selectedId == 'cloud' then ' active' else ''}", onClick: (-> onSelect('cloud')) }
          .fw-card-top
            %span.fw-card-name= cloudImage.name
            %span.fw-channel{ className: 'fw-channel fw-channel-cloud' }
              = 'cloud'
          %div.fw-card-version= "v#{cloudImage.version}"
          .fw-card-meta
            %span= cloudImage.target
            %span= fmtBytes(cloudImage.size)
          %div.fw-card-notes= cloudImage.notes
      - if localImage
        %button.fw-card{ className: "fw-card#{if selectedId == 'local' then ' active' else ''}", onClick: (-> onSelect('local')) }
          .fw-card-top
            %span.fw-card-name= localImage.name
            %span.fw-channel{ className: 'fw-channel fw-channel-local' }
              = 'local'
          %div.fw-card-version= 'custom'
          .fw-card-meta
            %span= localImage.target
            %span= fmtBytes(localImage.size)
          %div.fw-card-notes= localImage.notes
      - for fw, i in catalog
        %button.fw-card{ key: i, className: "fw-card#{if fw.id == selectedId then ' active' else ''}", onClick: (-> onSelect(fw.id)) }
          .fw-card-top
            %span.fw-card-name= fw.name
            %span.fw-channel{ className: "fw-channel fw-channel-#{fw.channel}" }
              = fw.channel
          %div.fw-card-version= "v#{fw.version}"
          .fw-card-meta
            %span= fw.target
            %span= fmtBytes(fw.size)
          %div.fw-card-date= fw.date
          %div.fw-card-notes= fw.notes