~~~
import { useI18n } from '../../../i18n/index.coffee'
~~~
- { t } = useI18n()
- log = props.log || []
- reversed = log.slice().reverse()
.flash-console
  .console-head
    %span.console-title= t('flash.flashLog')
    %button.console-clear{ onClick: props.onClear || (->) }
      = t('flash.clear')
  .console-body
    - if log.length == 0
      %div.console-empty= t('flash.consoleSilent')
    - else
      - for entry, i in reversed
        %div.console-line{ key: i, className: "console-line console-line-#{entry.level.toLowerCase()}" }
          %span.console-time= entry.t
          %span.console-level= entry.level
          %span.console-text= entry.text