~~~
import './SensorHardwarePanel.sass'
import useSensorsStore from '../../../stores/useSensorsStore.coffee'
import { ACC_HARDWARE, BARO_HARDWARE, MAG_HARDWARE } from '../../../lib/sensorsCatalog.coffee'
import { useI18n } from '../../../i18n/index.coffee'
~~~

- store = useSensorsStore()
- { t } = useI18n()
- config = store.draft.sensorConfig
- valueFromEvent = (f) -> (event) -> f Number(event.target.value)
- setAcc = (value) -> store.setSensorConfig { accHardware: value }
- setBaro = (value) -> store.setSensorConfig { baroHardware: value }
- setMag = (value) -> store.setSensorConfig { magHardware: value }
%Section{ heading: t('sensors.hardware'), subheading: t('sensors.hardwareSub') }
  .sensors-grid.panel-sensor-hardware
    %label.sensors-field
      %span.sensors-field-label= t('sensors.accelerometer')
      %select.sensors-select{ value: String(config.accHardware), onChange: valueFromEvent(setAcc) }
        - for item in ACC_HARDWARE
          %option{ key: "acc-#{item.id}", value: String(item.id) }
            = item.label
    %label.sensors-field
      %span.sensors-field-label= t('sensors.barometer')
      %select.sensors-select{ value: String(config.baroHardware), onChange: valueFromEvent(setBaro) }
        - for item in BARO_HARDWARE
          %option{ key: "baro-#{item.id}", value: String(item.id) }
            = item.label
    %label.sensors-field
      %span.sensors-field-label= t('sensors.magnetometer')
      %select.sensors-select{ value: String(config.magHardware), onChange: valueFromEvent(setMag) }
        - for item in MAG_HARDWARE
          %option{ key: "mag-#{item.id}", value: String(item.id) }
            = item.label
  %p.sensors-note
    = t('sensors.hardwareNote')
