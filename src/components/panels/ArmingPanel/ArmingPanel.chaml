~~~
import './ArmingPanel.sass'
import useSafetyStore from '../../../stores/useSafetyStore.coffee'
import { ARMING_SMALL_ANGLE_MAX, GYRO_CAL_ON_FIRST_ARM_DEFAULT } from '../../../lib/safetyCatalog.coffee'
import { useI18n } from '../../../i18n/index.coffee'
~~~

- store = useSafetyStore()
- { t } = useI18n()
- draft = store.draft.arming
- valueFromEvent = (f) -> (e) -> f e.target.value
%Section{ heading: t('safety.arming'), subheading: t('safety.armingSub') }
  .safety-grid.panel-arming
    %label.safety-field
      %span.safety-field-label= t('safety.autoDisarmDelay')
      %input.safety-input{ type: 'number', min: '0', max: '255', step: '1', value: String(draft.autoDisarmDelay), onChange: valueFromEvent((value) -> store.setArming { autoDisarmDelay: value }) }
    %label.safety-field
      %span.safety-field-label= t('safety.maxArmingAngle', { max: ARMING_SMALL_ANGLE_MAX })
      %input.safety-input{ type: 'number', min: '0', max: String(ARMING_SMALL_ANGLE_MAX), step: '1', value: String(draft.smallAngle), onChange: valueFromEvent((value) -> store.setArming { smallAngle: value }) }
  %p.safety-note
    = t('safety.armingNote', { default: GYRO_CAL_ON_FIRST_ARM_DEFAULT })
