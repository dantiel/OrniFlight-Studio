~~~
import './PowerMeterPanel.sass'
import usePowerStore from '../../../stores/usePowerStore.coffee'
import { useI18n } from '../../../i18n/index.coffee'
~~~

- store = usePowerStore()
- { t } = useI18n()
- voltageMeter = store.draft.voltageMeter
- currentMeter = store.draft.currentMeter
- valueFromEvent = (f) -> (event) -> f Number(event.target.value)
- setVoltageScale = (value) -> store.setVoltageMeter { scale: value }
- setDividerValue = (value) -> store.setVoltageMeter { dividerValue: value }
- setDividerMult = (value) -> store.setVoltageMeter { dividerMultiplier: value }
- setCurrentScale = (value) -> store.setCurrentMeter { scale: value }
- setCurrentOffset = (value) -> store.setCurrentMeter { offset: value }
%Section{ heading: t('power.meters'), subheading: t('power.metersSub') }
  .power-grid.panel-power-meter
    %label.power-field
      %span.power-field-label= t('power.voltScale')
      %input.power-input{ type: 'number', min: '0', max: '255', step: '1', value: String(voltageMeter.scale), onChange: valueFromEvent(setVoltageScale) }
    %label.power-field
      %span.power-field-label= t('power.dividerValue')
      %input.power-input{ type: 'number', min: '0', max: '255', step: '1', value: String(voltageMeter.dividerValue), onChange: valueFromEvent(setDividerValue) }
    %label.power-field
      %span.power-field-label= t('power.dividerMult')
      %input.power-input{ type: 'number', min: '0', max: '255', step: '1', value: String(voltageMeter.dividerMultiplier), onChange: valueFromEvent(setDividerMult) }
    %label.power-field
      %span.power-field-label= t('power.currScale')
      %input.power-input{ type: 'number', min: '0', max: '65535', step: '1', value: String(currentMeter.scale), onChange: valueFromEvent(setCurrentScale) }
    %label.power-field
      %span.power-field-label= t('power.currOffset')
      %input.power-input{ type: 'number', min: '0', max: '65535', step: '1', value: String(currentMeter.offset), onChange: valueFromEvent(setCurrentOffset) }
  %p.power-note
    = t('power.metersNote')
