~~~
import { useRef } from 'react'
import { Link } from 'react-router-dom'
import './MathView.sass'
import useTuningStore from '../../../stores/useTuningStore.coffee'
import useOrnithopterStore from '../../../stores/useOrnithopterStore.coffee'
import useScrollMorph, { scrollMorphTo } from '../../../hooks/useScrollMorph.coffee'
import { ondasHandlers } from '../PidTuningView/fieldHandlers.coffee'
import MathChain from './MathChain.coffee'
import MathLayerStack from './MathLayerStack.coffee'
import MathEspelho from './MathEspelho.coffee'
import MathWaveform from './MathWaveform.coffee'
import ModuleIcon from '../../primitives/ModuleIcon/ModuleIcon.coffee'
~~~

- store = useTuningStore()
- orni = useOrnithopterStore()
- hostRef = useRef(null)
- useScrollMorph(hostRef)
- draft = store.draft
- profileIndex = orni.draft.activeProfile
- modeLabel = if store.mode == 'sim' then 'SIMULATION' else 'DEVICE'
- readDisabled = store.mode != 'device' or !store.session
- saveDisabled = store.mode == 'device' and !store.loadedSession
.morph-doc.layout-math{ ref: hostRef }
  %header.morph-head
    %div.morph-head-title
      %span.morph-kicker.orgone-kicker
        = ' STEUERUNG · ONDAS MATHEMATIK'
      %h1.orgone-display.orgone-display-shimmer
        %ModuleIcon{ className: 'morph-head-glyph', size: 30 }
        %span Math
      %p.morph-hermes
        = "Die Mathematik-Suite des Vogels: achtzehn Parameter in zehn gekoppelten Schichten — vom PID-Fehler zur phasengekoppelten Schlagbewegung. Jede Schicht trägt Vorzeichen, Einheit und ihre Rolle; der Espelho-Spiegel liest die Schlag-Asymmetrie live."
  .morph-deck.math-deck
    %span.math-mode-badge{ className: "math-mode-#{store.mode}" }
      = modeLabel
    %span.math-profile-chip
      %Link{ to: '/profiles', className: 'math-profile-link' }
        = "Profil #{profileIndex + 1} · ONDAS-Ziel"
    - if store.dirty
      %span.math-dirty-badge DIRTY
    .math-actions
      %button.math-action{ type: 'button',
                            onClick: (-> store.loadFromDevice().catch (-> null)),
                            disabled: readDisabled }
        Read device
      %button.math-action{ type: 'button',
                            onClick: (-> store.save().catch (-> null)),
                            disabled: saveDisabled }
        Save
      %button.math-action{ type: 'button',
                            onClick: (-> store.revert()),
                            disabled: !store.dirty }
        Revert
      %button.math-action.math-action-spot{ type: 'button',
                                            onClick: (-> scrollMorphTo 'math-espelho-diag') }
        → Espelho
  .math-grid
    .math-rail
      %MathWaveform
    .math-flow
      .morph-section.math-chain
        %Section{ heading: 'Signal Chain',
                  subheading: 'Zehn Schichten in Flugrichtung — vom Regelfehler zur Schlagbewegung. Ein Klick bringt die Schicht in Sicht.' }
          %MathChain{ draft: draft }
      %MathLayerStack{ draft: draft, onInput: ondasHandlers }
  %MathEspelho