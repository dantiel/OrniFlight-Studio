~~~
import { useRef } from 'react'
import { NavLink } from 'react-router-dom'
import useTuningStore, { PID_GAIN_MAX } from '../../../stores/useTuningStore.coffee'
import { rateHandlers, filterHandlers } from './fieldHandlers.coffee'
import useScrollMorph from '../../../hooks/useScrollMorph.coffee'
import ParamRow from '../../primitives/ParamRow/ParamRow.chaml'
import PidBankGrid from './PidBankGrid.coffee'
import ModuleIcon from '../../primitives/ModuleIcon/ModuleIcon.coffee'
import { useI18n } from '../../../i18n/index.coffee'
~~~

- tuning = useTuningStore()
- draft = tuning.draft
- hostRef = useRef(null)
- useScrollMorph(hostRef)
- { t } = useI18n()
- modeLabel = if tuning.mode == 'sim' then t('common.simulation') else t('common.device')
- readDisabled = tuning.mode != 'device' or !tuning.session
- saveDisabled = tuning.mode == 'device' and !tuning.loadedSession
- gyroDlpfDisplay = "#{draft.filter.gyroDlpfHz} Hz"
- gyroNotchDisplay = "#{draft.filter.gyroNotchHz} Hz"
- dTermDlpfDisplay = "#{draft.filter.dTermDlpfHz} Hz"
.morph-doc.layout-pid{ ref: hostRef }
  %header.morph-head
    %div.morph-head-title
      %span.morph-kicker.orgone-kicker
        = t('pid.kicker')
      %h1.orgone-display.orgone-display-shimmer
        %ModuleIcon{ className: 'morph-head-glyph', size: 30 }
        %span= t('pid.title')
      %p.morph-hermes
        = t('pid.hermes')
  .morph-deck.pid-deck
    %span.pid-mode-badge{ className: "pid-mode-#{tuning.mode}" }
      = modeLabel
    - if tuning.dirty
      %span.pid-dirty-badge= t('common.unsaved')
    .pid-actions
      %button.pid-action.pid-action-read{ type: 'button',
                                          onClick: (-> tuning.loadFromDevice().catch (-> null)),
                                          disabled: readDisabled }
        = t('common.read')
      %button.pid-action.pid-action-save{ type: 'button',
                                          onClick: (-> tuning.save().catch (-> null)),
                                          disabled: saveDisabled }
        = t('common.save')
      %button.pid-action.pid-action-revert{ type: 'button',
                                            onClick: (-> tuning.revert()),
                                            disabled: !tuning.dirty }
        = t('common.revert')
  - if tuning.mode == 'sim'
    %div.pid-sim-banner= t('pid.simBanner')
  - if tuning.lastError
    .pid-error{ role: 'alert' }
      = tuning.lastError
  .morph-section.pid-bank
    %Section{ heading: t('pid.bank'),
              subheading: t('pid.bankSub') }
      %PidBankGrid{ draft: draft, pidMax: PID_GAIN_MAX }
  .pid-split
    .morph-section.pid-rates
      %Section{ heading: t('pid.rates'),
                subheading: t('pid.ratesSub') }
        %ParamRow{ key: 'rate-rcRate',
                   label: t('pid.rcRate'),
                   value: draft.rate.rcRate,
                   min: '0',
                   max: '250',
                   step: '1',
                   display: String(draft.rate.rcRate),
                   onInput: rateHandlers.rcRate }
        %ParamRow{ key: 'rate-superRate',
                   label: t('pid.superRate'),
                   value: draft.rate.superRate,
                   min: '0',
                   max: '100',
                   step: '1',
                   display: String(draft.rate.superRate),
                   onInput: rateHandlers.superRate }
        %ParamRow{ key: 'rate-expo',
                   label: t('pid.expo'),
                   value: draft.rate.expo,
                   min: '0',
                   max: '100',
                   step: '1',
                   display: String(draft.rate.expo),
                   onInput: rateHandlers.expo }
    .morph-section.pid-filters
      %Section{ heading: t('pid.filters'),
                subheading: t('pid.filtersSub') }
        %ParamRow{ key: 'filter-gyroDlpf',
                   label: t('pid.gyroDlpf'),
                   value: draft.filter.gyroDlpfHz,
                   min: '0',
                   max: '1000',
                   step: '1',
                   display: gyroDlpfDisplay,
                   onInput: filterHandlers.gyroDlpfHz }
        %ParamRow{ key: 'filter-gyroNotch',
                   label: t('pid.gyroNotch'),
                   value: draft.filter.gyroNotchHz,
                   min: '0',
                   max: '1000',
                   step: '1',
                   display: gyroNotchDisplay,
                   onInput: filterHandlers.gyroNotchHz }
        %ParamRow{ key: 'filter-notchQ',
                   label: t('pid.notchQ'),
                   value: draft.filter.gyroNotchQ,
                   min: '0',
                   max: '16',
                   step: '1',
                   display: String(draft.filter.gyroNotchQ),
                   onInput: filterHandlers.gyroNotchQ }
        %ParamRow{ key: 'filter-dTermDlpf',
                   label: t('pid.dTermDlpf'),
                   value: draft.filter.dTermDlpfHz,
                   min: '0',
                   max: '1000',
                   step: '1',
                   display: dTermDlpfDisplay,
                   onInput: filterHandlers.dTermDlpfHz }
  .morph-section.pid-ondas-link
    %Section{ heading: t('pid.ondas'),
              subheading: t('pid.ondasSub') }
      .pid-ondas-body
        %p.pid-ondas-note
          = t('pid.ondasNote')
        %NavLink.pid-ondas-cta{ to: '/control/strokedynamics' }
          = t('pid.ondasCta')