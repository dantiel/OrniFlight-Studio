~~~
import { useRef } from 'react'
import { fmt0, intFromEvent } from '../../../lib/essential.coffee'
import useReceiverStore from '../../../stores/useReceiverStore.coffee'
import useTelemetryStore from '../../../stores/useTelemetryStore.coffee'
import useScrollMorph from '../../../hooks/useScrollMorph.coffee'
import {
  SERIALRX_PROVIDERS, RC_CHANNEL_LETTERS, RXFAIL_MODE, RXFAIL_STEP_MAX
} from '../../../protocol/mspDecoders.coffee'
import ModuleIcon from '../../primitives/ModuleIcon/ModuleIcon.coffee'
import { useI18n } from '../../../i18n/index.coffee'
~~~

- store = useReceiverStore()
- draft = store.draft
- hostRef = useRef(null)
- useScrollMorph(hostRef)
- { t } = useI18n()
- telemetry = useTelemetryStore (state) -> state.rcChannels
- modeLabel = if store.mode == 'sim' then t('common.simulation') else t('common.device')
- readDisabled = store.mode != 'device' or !store.session
- saveDisabled = store.mode == 'device' and !store.loadedSession
- POSITION_LABELS = ['ROLL', 'PITCH', 'YAW', 'THROTTLE', 'AUX1', 'AUX2', 'AUX3', 'AUX4']
- RXFAIL_LABELS = ['AUTO', 'HOLD', 'SET', 'INVALID']
- CHANNEL_LETTERS = RC_CHANNEL_LETTERS.split ''
- pct = (v) -> Math.max 0, Math.min 100, (v - 885) / 12.3
- chanPct = (index) -> pct telemetry[index] or 0
- valueFromEvent = (f) -> (e) -> f e.target.value
- log = (label) -> (error) -> console.error label, error
- readFromDevice = -> store.loadFromDevice().catch log 'Receiver read failed'
- saveToDevice = -> store.save().catch log 'Receiver save failed'
- setRx = (key) -> (value) -> store.setRxConfigField key, value
- setMap = (position) -> (value) -> store.setChannelMapPosition position, value
- setFail = (index, key) -> (value) -> store.setRxFailField index, key, value
- maxcheckDisplay = "#{fmt0(draft.maxcheck)} µs"
- midrcDisplay = "#{fmt0(draft.midrc)} µs"
- mincheckDisplay = "#{fmt0(draft.mincheck)} µs"
- rxMinUsecDisplay = "#{fmt0(draft.rxMinUsec)} µs"
- rxMaxUsecDisplay = "#{fmt0(draft.rxMaxUsec)} µs"
- airmodeDisplay = "#{fmt0(draft.airModeActivateThreshold * 10 + 1000)} µs"
.morph-doc.layout-receiver{ ref: hostRef }
  %header.morph-head
    %div.morph-head-title
      %span.morph-kicker.orgone-kicker
        = t('receiver.kicker')
      %h1.orgone-display.orgone-display-shimmer
        %ModuleIcon{ className: 'morph-head-glyph', size: 30 }
        %span= t('receiver.title')
      %p.morph-hermes
        = t('receiver.hermes')
  .morph-deck.receiver-deck
    %span.receiver-mode-badge{ className: "receiver-mode-#{store.mode}" }
      = modeLabel
    - if store.dirty
      %span.receiver-dirty-badge= t('common.unsaved')
    .receiver-actions
      %button.receiver-action.receiver-action-read{ type: 'button',
                                                    onClick: readFromDevice,
                                                    disabled: readDisabled }
        = t('common.read')
      %button.receiver-action.receiver-action-save{ type: 'button',
                                                    onClick: saveToDevice,
                                                    disabled: saveDisabled }
        = t('common.save')
      %button.receiver-action.receiver-action-revert{ type: 'button',
                                                      onClick: (-> store.revert()),
                                                      disabled: !store.dirty }
        = t('common.revert')
  .receiver-split
    .morph-section.receiver-side
      %Section{ heading: t('receiver.protocol'),
                subheading: t('receiver.protocolSub') }
        %select.receiver-provider{ value: String(draft.provider), onChange: valueFromEvent(setRx('provider')) }
          - for provider in SERIALRX_PROVIDERS
            %option{ key: "provider-#{provider.id}", value: String(provider.id) }
              = provider.label
        %ParamRow{ key: 'maxcheck',
                   label: t('receiver.maxCheck'),
                   value: draft.maxcheck,
                   min: '500',
                   max: '2500',
                   step: '5',
                   display: maxcheckDisplay,
                   onInput: intFromEvent(setRx('maxcheck')) }
        %ParamRow{ key: 'midrc',
                   label: t('receiver.midRc'),
                   value: draft.midrc,
                   min: '500',
                   max: '2500',
                   step: '5',
                   display: midrcDisplay,
                   onInput: intFromEvent(setRx('midrc')) }
        %ParamRow{ key: 'mincheck',
                   label: t('receiver.minCheck'),
                   value: draft.mincheck,
                   min: '500',
                   max: '2500',
                   step: '5',
                   display: mincheckDisplay,
                   onInput: intFromEvent(setRx('mincheck')) }
        %ParamRow{ key: 'rx-min-usec',
                   label: t('receiver.rxMinPulse'),
                   value: draft.rxMinUsec,
                   min: '500',
                   max: '3000',
                   step: '5',
                   display: rxMinUsecDisplay,
                   onInput: intFromEvent(setRx('rxMinUsec')) }
        %ParamRow{ key: 'rx-max-usec',
                   label: t('receiver.rxMaxPulse'),
                   value: draft.rxMaxUsec,
                   min: '500',
                   max: '3000',
                   step: '5',
                   display: rxMaxUsecDisplay,
                   onInput: intFromEvent(setRx('rxMaxUsec')) }
        %ParamRow{ key: 'airmode-threshold',
                   label: t('receiver.airmodeThreshold'),
                   value: draft.airModeActivateThreshold,
                   min: '0',
                   max: '250',
                   step: '1',
                   display: airmodeDisplay,
                   onInput: intFromEvent(setRx('airModeActivateThreshold')) }
    .morph-section.receiver-map
      %Section{ heading: t('receiver.channelMap'),
                subheading: t('receiver.channelMapSub') }
        - for position in [0...8]
          .channel-map-row{ key: "cmap-#{position}" }
            %span.channel-map-label
              = POSITION_LABELS[position]
            %select.channel-map-select{ value: draft.channelMap[position], onChange: valueFromEvent(setMap(position)) }
              - for letter in CHANNEL_LETTERS
                %option{ key: "letter-#{letter}", value: letter }
                  = letter
  .morph-section.receiver-failsafe
    %Section{ heading: t('receiver.failsafeChannels'),
              subheading: t('receiver.failsafeChannelsSub') }
    - for channel, index in draft.rxFail
      .rxfail-row{ key: "rxfail-#{index}" }
        %span.rxfail-label
          = t('receiver.channel', { n: index + 1 })
        %select.rxfail-mode{ value: String(channel.mode), onChange: valueFromEvent(setFail(index, 'mode')) }
          - for label, modeValue in RXFAIL_LABELS
            %option{ key: "rxfail-mode-#{modeValue}", value: String(modeValue) }
              = label
        %input.rxfail-slider{ type: 'range', min: '0', max: String(RXFAIL_STEP_MAX), step: '1', value: String(channel.step), onInput: intFromEvent(setFail(index, 'step')) }
        %span.rxfail-value
          = "#{fmt0(750 + channel.step * 25)} µs"
  .morph-section.receiver-tele
    %Section{ heading: t('receiver.liveChannels'),
              subheading: t('receiver.liveChannelsSub') }
    .channel-bars
      - for index in [0...18]
        .channel-bar-cell{ key: "chan-#{index}" }
          %span.channel-bar-label
            = CHANNEL_LETTERS[index] or index + 1
          .channel-bar-track
            .channel-bar-fill{ style: { width: "#{chanPct(index)}%" } }
