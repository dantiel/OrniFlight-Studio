- import useFlashController from '../../../hooks/useFlashController.coffee'
- import { FLASH_OPTIONS } from '../../../firmware/flashUi.coffee'
- ctrl = useFlashController()
.view-layout.layout-flash
  %ViewArea{ area: 'device' }
    %DeviceTarget{
      device: ctrl.device,
      connected: ctrl.connected,
      transport: ctrl.transport,
      serialSupported: ctrl.serialSupported,
      webUsbSupported: ctrl.webUsbSupported,
      detecting: ctrl.detecting,
      onDetectSerial: ctrl.onDetectSerial,
      onDetectWebUsb: ctrl.onDetectWebUsb,
      onDisconnect: ctrl.onDisconnect
    }
  %ViewArea{ area: 'library' }
    %FirmwareLibrary{ catalog: ctrl.catalog, loading: ctrl.loading, selectedId: ctrl.selectedId, localImage: ctrl.localImage, onSelect: ctrl.onSelect, onLoadLocal: ctrl.onLoadLocal }
  %ViewArea{ area: 'forge' }
    %div.forge-stage
      %FlashProgress{ phase: ctrl.phase, progress: ctrl.progress, label: ctrl.label }
      %div.forge-actions
        %FlashButton{ variant: ctrl.btn.variant, label: ctrl.btn.label, glyph: ctrl.btn.glyph, disabled: ctrl.btn.disabled, onClick: ctrl.onClick }
      %div.forge-options
        - for opt in FLASH_OPTIONS
          %label.fw-option{ key: opt[0] }
            %input.fw-option-check{ type: 'checkbox', checked: ctrl.options[opt[0]], onChange: (e) -> ctrl.onOption(opt[0], e.target.checked) }
            %span.fw-option-label= opt[1]
            %span.fw-option-hint= opt[2]
      - if ctrl.error
        %div.forge-error= ctrl.error
  %ViewArea{ area: 'console' }
    %FlashConsole{ log: ctrl.log, onClear: ctrl.onClearLog }
