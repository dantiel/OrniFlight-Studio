~~~
import { useRef } from 'react'
import './ServosView.sass'
import useServoStore from '../../../stores/useServoStore.coffee'
import useOrnithopterStore from '../../../stores/useOrnithopterStore.coffee'
import useScrollMorph from '../../../hooks/useScrollMorph.coffee'
import {
  profileById, controlSurfacesForProfile
} from '../../../lib/mixerCatalog.coffee'
import { INPUT_SOURCES } from '../../../lib/servoCatalog.coffee'
import { useI18n, T } from '../../../i18n/index.coffee'
import ModuleIcon from '../../primitives/ModuleIcon/ModuleIcon.coffee'
~~~

- store = useServoStore()
- orni = useOrnithopterStore()
- hostRef = useRef(null)
- useScrollMorph(hostRef)
- { t } = useI18n()
- profile = profileById(orni.draft.profileId)
- surfaces = controlSurfacesForProfile(profile)
- modeLabel = if store.mode == 'sim' then t('servos.simulation') else t('servos.device')
- readDisabled = store.mode != 'device' or !store.session
- saveDisabled = store.mode == 'device' and !store.loadedSession
- surfaceOf = (id) -> store.draft.surfaces[id]
- sourceChange = (id) -> (e) -> store.setSurfaceSource id, e.target.value
- channelChange = (id) -> (e) -> store.setSurfaceChannel id, parseInt(e.target.value)
- channelLabel = (n) -> t('servo.channel', { n: n + 1 })
.morph-doc.layout-servos{ ref: hostRef }
  %header.morph-head
    %div.morph-head-title
      %span.morph-kicker.orgone-kicker
        = t('servos.kicker')
      %h1.orgone-display.orgone-display-shimmer
        %ModuleIcon{ className: 'morph-head-glyph', size: 30 }
        %span= t('servos.title')
      %T{ k: 'servos.hermes_markdown', as: 'p', className: 'morph-hermes' }
  .morph-deck.servos-deck
    %span.servos-mode-badge{ className: "servos-mode-#{store.mode}" }
      = modeLabel
    %span.servos-profile-chip
      = "#{profile.name}"
    - if store.dirty
      %span.servos-dirty-badge= t('common.unsaved')
    .servos-actions
      %button.servos-action.servos-action-read{ type: 'button',
                                                onClick: (-> store.loadFromDevice().catch (-> null)),
                                                disabled: readDisabled }
        = t('servos.read')
      %button.servos-action.servos-action-save{ type: 'button',
                                                onClick: (-> store.save().catch (-> null)),
                                                disabled: saveDisabled }
        = t('servos.save')
      %button.servos-action.servos-action-revert{ type: 'button',
                                                  onClick: (-> store.revert()),
                                                  disabled: !store.dirty }
        = t('servos.revert')
  - if surfaces.length == 0
    .servos-empty
      %Section{ heading: t('servos.emptyHeading'),
                subheading: t('servos.emptySub') }
        %p.servos-note
          = t('servos.emptyNote', { mixer: profile.name })
  - else
    .morph-section.servos-main
      %Section{ heading: t('servos.sectionHeading'),
                subheading: t('servos.sectionSub', { count: profile.servos }) }
        - for surface in surfaces
          .servos-surface{ key: surface.id }
            %span.servos-surface-name
              = t(surface.label)
            .servos-surface-fields
              %label.servos-surface-field
                %span.servos-field-label= t('servos.inputSource')
                %select.servos-surface-select{
                  value: surfaceOf(surface.id).inputSource,
                  onChange: sourceChange(surface.id) }
                  - for source in INPUT_SOURCES
                    %option{ key: source.id, value: source.id }
                      = t(source.label)
              %label.servos-surface-field
                %span.servos-field-label= t('servos.targetChannel')
                %select.servos-surface-select{
                  value: String(surfaceOf(surface.id).targetChannel),
                  onChange: channelChange(surface.id) }
                  - for n in [0...profile.servos]
                    %option{ key: n, value: String(n) }
                      = channelLabel(n)
