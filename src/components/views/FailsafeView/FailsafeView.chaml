~~~
import { memo, useRef } from 'react'
import './FailsafeView.sass'
import useSafetyStore from '../../../stores/useSafetyStore.coffee'
import useScrollMorph from '../../../hooks/useScrollMorph.coffee'
~~~

- store = useSafetyStore()
- hostRef = useRef(null)
- useScrollMorph(hostRef)
- modeLabel = if store.mode == 'sim' then 'SIMULATION' else 'DEVICE'
- readDisabled = store.mode != 'device' or !store.session
- saveDisabled = store.mode == 'device' and !store.loadedSession
- log = (label) -> (error) -> console.error label, error
- readFromDevice = -> store.loadFromDevice().catch log 'Safety read failed'
- saveToDevice = -> store.save().catch log 'Safety save failed'
.morph-doc.layout-safety{ ref: hostRef }
  %header.morph-head
    %div.morph-head-title
      %span.morph-kicker.orgone-kicker SYSTEM · SICHERHEIT
      %h1.orgone-display.orgone-display-shimmer Sicherheit
      %p.morph-hermes
        = "Failsafe, arming, features and beeper — MSP 36/37, 61/62, 75/76, 184/185. Saves verify their read-back; writes lock while armed."
  .morph-deck.safety-deck
    %span.safety-mode-badge{ className: "safety-mode-#{store.mode}" }
      = modeLabel
    - if store.dirty
      %span.safety-dirty-badge DIRTY
    .safety-actions
      %button.safety-action.safety-action-read{ type: 'button', onClick: readFromDevice, disabled: readDisabled }
        Read device
      %button.safety-action.safety-action-save{ type: 'button', onClick: saveToDevice, disabled: saveDisabled }
        Save
      %button.safety-action.safety-action-revert{ type: 'button', onClick: (-> store.revert()), disabled: !store.dirty }
        Revert
  .morph-section.safety-side
    %Section{ heading: 'Safety', subheading: 'Failsafe, arming, features and beeper — MSP 36/37, 61/62, 75/76, 184/185.' }
      %p.safety-note
        = "All four documents ride the wire format exactly. Every save runs SET + EEPROM_WRITE and verifies the read-back; writes lock while armed."
    - if store.lastError
      %div.safety-error{ role: 'alert' }
        = store.lastError
  .morph-section.safety-main
    %FailsafePanel
    %ArmingPanel
    %FeaturePanel
    %BeeperPanel