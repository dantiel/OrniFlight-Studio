- import { fmt1 } from '../../../lib/essential.coffee'
- import useEngineStore from '../../../stores/useEngineStore.coffee'
- import useTelemetryStore from '../../../stores/useTelemetryStore.coffee'
- import useAppStore from '../../../stores/useAppStore.coffee'
- sim = useEngineStore()
- tele = useTelemetryStore()
- storedTab = useAppStore (s) -> s.activeTab
- setActiveTab = useAppStore (s) -> s.setActiveTab
- activeTab = props.tab || storedTab
- waveCurves = useAppStore (s) -> s.waveCurves
- setWaveCurves = useAppStore (s) -> s.setWaveCurves
- gyroCurves = useAppStore (s) -> s.gyroCurves
- setGyroCurves = useAppStore (s) -> s.setGyroCurves
.view-layout.layout-flight
  %ViewArea{ area: 'vport' }
    %DeferredAircraftViewport{ attitude: tele.attitude || [0, 0, 0], wingAngleL: tele.wingAngleL || 0, wingAngleR: tele.wingAngleR || 0, flapFrequency: tele.flapFrequency || 0, onBump: sim.bump }
    %ViewportOverlay{ badges: ["Cadence #{fmt1(tele.flapFrequency)} Hz", "Stroke #{fmt1(tele.amplitude)}°"] }
  %ViewArea{ area: 'params' }
    - unless props.tab
      %TabBar{ activeTab: activeTab, onTabChange: setActiveTab }
    - if activeTab == 'servos'
      %ServoInspector{ servo: sim.servos[sim.selectedServoIndex], index: sim.selectedServoIndex, onParamChange: sim.setServoParam, pidGains: sim.pidGains, onPidChange: sim.setPidGain, ondasParams: sim.ondasParams, onOndasChange: sim.setOndasParam, mode: 'servos' }
    - if activeTab == 'pid'
      %ServoInspector{ servo: sim.servos[sim.selectedServoIndex], index: sim.selectedServoIndex, onParamChange: sim.setServoParam, pidGains: sim.pidGains, onPidChange: sim.setPidGain, ondasParams: sim.ondasParams, onOndasChange: sim.setOndasParam, mode: 'pid' }
    - if activeTab == 'ondas'
      %ServoInspector{ servo: sim.servos[sim.selectedServoIndex], index: sim.selectedServoIndex, onParamChange: sim.setServoParam, pidGains: sim.pidGains, onPidChange: sim.setPidGain, ondasParams: sim.ondasParams, onOndasChange: sim.setOndasParam, mode: 'ondas' }
  %ViewArea{ area: 'tele' }
    %PlotWorkspace{ workspace: 'control', history: tele.waveformHistory || [] }
