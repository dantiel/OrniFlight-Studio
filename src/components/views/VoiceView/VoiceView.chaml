- import useEngineStore from '../../../stores/useEngineStore.coffee'
- import useTelemetryStore from '../../../stores/useTelemetryStore.coffee'
- import useDeviceStore from '../../../stores/useDeviceStore.coffee'
- CHANS = ['Roll', 'Pitch', 'Yaw', 'Throttle', 'Aux 1', 'Aux 2', 'Aux 3', 'Aux 4']
- sim = useEngineStore()
- tele = useTelemetryStore()
- device = useDeviceStore()
- visibleChannels = if tele.rcChannels?.length then tele.rcChannels.slice(0, 16) else [0, 0, 0, 0]
- channelDisplays = visibleChannels.map((value) -> if value then "#{value} µs" else '—')
- sourceDisplay = if device.source == 'device' then 'Live MSP data' else 'Offline profile'
- mappingDisplay = if device.identity?.rxMap?.length then device.identity.rxMap.join(' · ') else 'Read on connect'
- statusDisplay = if device.status?.armed then 'Armed · editing locked' else 'Disarmed'
- linkDisplay = if tele.linkQuality then "#{Math.round(tele.linkQuality)}%" else 'Not reported by MSP'
- updateDisplay = if tele.source == 'device' then 'Flight controller' else 'Waiting'
.view-layout.layout-voice
  %ViewArea{ area: 'proto' }
    %Section{ heading: 'Receiver', subheading: 'Input transport and firmware mapping.' }
      %ParamRow{ label: 'Source', display: sourceDisplay }
      %ParamRow{ label: 'Channels', display: String(tele.rcChannels?.length || 0) }
      %ParamRow{ label: 'Mapping', display: mappingDisplay }
      %ParamRow{ label: 'Status', display: statusDisplay }
  %ViewArea{ area: 'chans' }
    %Section{ heading: 'Live Channels', subheading: 'Raw receiver pulse values from the controller.' }
      - for value, i in visibleChannels
        %ParamRow{ key: i, label: CHANS[i] || "CH#{i + 1}", display: channelDisplays[i] }
  %ViewArea{ area: 'link' }
    %Section{ heading: 'Link Quality', subheading: 'Signal health and diagnostics.' }
      %ParamRow{ label: 'RSSI', display: "#{Math.round(tele.rssi || 0)}%" }
      %ParamRow{ label: 'Link quality', display: linkDisplay }
      %ParamRow{ label: 'Update source', display: updateDisplay }
  %ViewArea{ area: 'bird' }
    %PlotWorkspace{ workspace: 'receiver', history: tele.waveformHistory || [] }