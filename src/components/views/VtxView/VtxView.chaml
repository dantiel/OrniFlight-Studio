~~~
import { memo } from 'react'
import useVtxStore from '../../../stores/useVtxStore.coffee'
import { VTX_BANDS, VTX_CHANNEL_COUNT, VTX_POWER_LEVELS, VTX_TYPE_LABELS, bandLabel, bandLetter, lookupBandChannel } from '../../../lib/vtxCatalog.coffee'
~~~

- store = useVtxStore()
- draft = store.draft
- modeLabel = if store.mode == 'sim' then 'SIMULATION' else 'DEVICE'
- readDisabled = store.mode != 'device' or !store.session
- saveDisabled = store.mode == 'device' and !store.loadedSession
- typeLabel = VTX_TYPE_LABELS[draft.vtxType] ? 'Unknown'
- located = if draft.band == 0 then lookupBandChannel(draft.freq) else null
- freqNote = if draft.band >= 1 then "#{bandLabel(draft.band)} CH#{draft.channel} — #{bandLetter(draft.band)}#{draft.channel}" else if located? then "CUSTOM — ≈ #{bandLabel(located.band)} #{located.channel}" else 'CUSTOM'
- valueFromEvent = (f) -> (e) -> f e.target.value
- boolFromEvent = (f) -> (e) -> f e.target.checked
- log = (label) -> (error) -> console.error label, error
- readFromDevice = -> store.loadFromDevice().catch log 'VTX read failed'
- saveToDevice = -> store.save().catch log 'VTX save failed'
.system-view
  .system-view-head
    .system-view-badges
      %span.system-mode-badge{ className: "system-mode-#{store.mode}" }
        = modeLabel
      - if store.dirty
        %span.system-dirty-badge DIRTY
    %h1.system-view-title VTX
    .system-view-actions
      %button.system-action.system-action-read{ type: 'button', onClick: readFromDevice, disabled: readDisabled }
        Read device
      %button.system-action.system-action-save{ type: 'button', onClick: saveToDevice, disabled: saveDisabled }
        Save
      %button.system-action.system-action-revert{ type: 'button', onClick: (-> store.revert()), disabled: !store.dirty }
        Revert
  %Section{ heading: 'VTX Transmitter', subheading: 'MSP 88/89 — 5.8 GHz, band 0 = custom.' }
    %p.system-note
      = "Device type: #{typeLabel}"
  .system-card
    .system-card-grid
      %label.system-field
        %span.system-field-label Band
        %select.vtx-select{ value: String(draft.band), onChange: valueFromEvent((value) -> store.setBand Number(value)) }
          %option{ value: '0', disabled: true } CUSTOM
          - for band in VTX_BANDS
            %option{ key: "band-#{band.index}", value: String(band.index) }
              = band.name
      %label.system-field
        %span.system-field-label Channel
        %select.vtx-select{ value: String(draft.channel), disabled: draft.band == 0, onChange: valueFromEvent((value) -> store.setChannel Number(value)) }
          - for channel in [1..VTX_CHANNEL_COUNT]
            %option{ key: "ch-#{channel}", value: String(channel) }
              = "CH#{channel}"
      %label.system-field
        %span.system-field-label Custom MHz
        %input.vtx-freq-input{ type: 'number', min: '5600', max: '5950', step: '1', value: String(draft.freq), onChange: valueFromEvent((value) -> store.setCustomFreq value) }
      %label.system-field
        %span.system-field-label Power
        %select.vtx-select{ value: String(draft.power), onChange: valueFromEvent((value) -> store.setPower Number(value)) }
          - for level in VTX_POWER_LEVELS
            %option{ key: "power-#{level.value}", value: String(level.value) }
              = level.label
    .system-toggle-row
      %label.system-toggle
        %input.system-check{ type: 'checkbox', checked: Boolean(draft.pitmode), onChange: boolFromEvent((value) -> store.setPitMode value) }
        %span Pit mode
      %label.system-toggle
        %input.system-check{ type: 'checkbox', checked: Boolean(draft.lowPowerDisarm), onChange: boolFromEvent((value) -> store.setLowPowerDisarm value) }
        %span Low power on disarm
  .system-frequency-block
    .vtx-frequency
      = draft.freq
      %span.system-frequency-unit MHz
    .system-frequency-note
      = freqNote
  .system-band-table
    .system-band-table-head
      %span.system-band-corner CH
      - for channel in [1..VTX_CHANNEL_COUNT]
        %span.system-band-colhead{ key: "ch-#{channel}" }
          = channel
    - for band in VTX_BANDS
      .system-band-row{ key: "band-#{band.index}" }
        %span.system-band-name
          = band.name
        - for freq, chIndex in band.frequencies
          %button.system-band-cell{ key: "cell-#{band.index}-#{chIndex}", type: 'button', className: "system-band-cell#{if draft.freq == freq then ' vtx-band-cell-active' else ''}", onClick: (-> store.setBandChannel band.index, chIndex + 1) }
            = freq