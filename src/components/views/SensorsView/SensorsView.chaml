~~~
import { memo, useRef } from 'react'
import './SensorsView.sass'
import useSensorsStore from '../../../stores/useSensorsStore.coffee'
import useScrollMorph from '../../../hooks/useScrollMorph.coffee'
import ModuleIcon from '../../primitives/ModuleIcon/ModuleIcon.coffee'
import { useI18n } from '../../../i18n/index.coffee'
~~~

- store = useSensorsStore()
- hostRef = useRef(null)
- useScrollMorph(hostRef)
- { t } = useI18n()
- modeLabel = if store.mode == 'sim' then t('common.simulation') else t('common.device')
- readDisabled = store.mode != 'device' or !store.session
- saveDisabled = store.mode == 'device' and !store.loadedSession
- log = (label) -> (error) -> console.error label, error
- readFromDevice = -> store.loadFromDevice().catch log 'Sensor read failed'
- saveToDevice = -> store.save().catch log 'Sensor save failed'
.morph-doc.layout-sensors{ ref: hostRef }
  %header.morph-head
    %div.morph-head-title
      %span.morph-kicker.orgone-kicker
        = t('sensors.kicker')
      %h1.orgone-display.orgone-display-shimmer
        %ModuleIcon{ className: 'morph-head-glyph', size: 30 }
        %span= t('sensors.title')
      %p.morph-hermes
        = t('sensors.hermes')
  .morph-deck.sensors-deck
    %span.sensors-mode-badge{ className: "sensors-mode-#{store.mode}" }
      = modeLabel
    - if store.dirty
      %span.sensors-dirty-badge= t('common.unsaved')
    .sensors-actions
      %button.sensors-action.sensors-action-read{ type: 'button', onClick: readFromDevice, disabled: readDisabled }
        = t('common.read')
      %button.sensors-action.sensors-action-save{ type: 'button', onClick: saveToDevice, disabled: saveDisabled }
        = t('common.save')
      %button.sensors-action.sensors-action-revert{ type: 'button', onClick: (-> store.revert()), disabled: !store.dirty }
        = t('common.revert')
  .morph-section.sensors-side
    %Section{ heading: t('sensors.heading'), subheading: t('sensors.sub') }
      %p.sensors-note
        = t('sensors.note')
    - if store.lastError
      %div.sensors-error{ role: 'alert' }
        = store.lastError
  .morph-section.sensors-main
    %SensorHardwarePanel
    %SensorAlignmentPanel
    %SensorCalibratePanel
